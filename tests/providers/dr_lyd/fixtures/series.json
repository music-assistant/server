000","isAvailableOnDemand":true,"explicitContent":false,"categories":["Musik","Underholdning"],"channel":{"title":"P4","slug":"p4"},"imageAssets":[{"id":"urn:dr:radio:image:690b1611af2a6e71cb8e8fa8","target":"Default","ratio":"16:9","format":"image/jpeg"},{"id":"urn:dr:radio:image:690b1625af2a6e71cb8e90e7","target":"SquareImage","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:690b1611af2a6e71cb8e8fa9","target":"Podcast","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:690b1625af2a6e71cb8e90e7","target":"Default","ratio":"1:1","format":"image/jpeg"}]},{"type":"Series","id":"urn:dr:radio:series:5fa25df4330eac2f135b5d48","title":"Tættere på himlen","description":"Det er fredag og weekend om lidt, så her er der grov stemning, høj energi og hits! hits! hits!","numberOfEpisodes":34,"latestEpisodeStartTime":"2026-10-30T13:03:00+00:00","productionNumber":"2553137358000","presentationUrl":"https://www.dr.dk/lyd/special-radio/taettere-paa-himlen-2553137358000","isAvailableOnDemand":true,"explicitContent":false,"categories":["Musik"],"channel":{"title":"SPECIAL RADIO","slug":"special-radio"},"imageAssets":[{"id":"urn:dr:radio:image:67e69e148b2e4877edcda2ca","target":"Default","ratio":"16:9","format":"image/jpeg"},{"id":"urn:dr:radio:image:67e69e148b2e4877edcda2cb","target":"SquareImage","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:67e69e148b2e4877edcda2cc","target":"Podcast","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:67e69e148b2e4877edcda2cb","target":"Default","ratio":"1:1","format":"image/jpeg"}]},{"type":"Series","id":"urn:dr:radio:series:61f24e160431527cb3065776","title":"De Lovløse","description":"Danmark har gennem tiden leveret et ikke ubetydeligt bidrag til bunken af storslåede kupmagere, gangstere, cowboy outlaws og sørøvere. Mange af dem er bare gået lidt i glemmebogen.\nI serien 'De Lovløse' fortæller Emil Rothstein-Christensen alle de vanvittige og hæsblæsende historier om danskere, der er endt langt uden for lands lov og ret, men ikke desto mindre har været med til at ændre både Danmarks- og verdenshistorien.\nDet er actionfyldte lydfortællinger baseret på den vilde virkelighed.\nProduceret for DR af MonoMono.","numberOfEpisodes":62,"latestEpisodeStartTime":"2026-06-23T03:06:00+00:00","productionNumber":"3337857881000","presentationUrl":"https://www.dr.dk/lyd/special-radio/de-lovloese-3337857881000","isAvailableOnDemand":true,"explicitContent":false,"categories":["Dokumentar","Krimi","Historie"],"channel":{"title":"SPECIAL RADIO","slug":"special-radio"},"imageAssets":[{"id":"urn:dr:radio:image:68fb4aeb91066218a48cd604","target":"Default","ratio":"16:9","format":"image/png"},{"id":"urn:dr:radio:image:68fb4aff5f699d2ab1739ecb","target":"SquareImage","ratio":"1:1","format":"image/png"},{"id":"urn:dr:radio:image:68fb4ae05f699d2ab1739d83","target":"Podcast","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:68fb4aff5f699d2ab1739ecb","target":"Default","ratio":"1:1","format":"image/png"}]},{"type":"Series","id":"urn:dr:radio:series:5fa25d76330eac2f135b5a8f","title":"Radioavisen","description":"De seneste nyheder - døgnet rundt.","numberOfEpisodes":97,"latestEpisodeStartTime":"2026-11-05T23:00:00+00:00","productionNumber":"2467664383000","presentationUrl":"https://www.dr.dk/lyd/p4/radioavisen-2467664383000","isAvailableOnDemand":true,"explicitContent":false,"categories":["Nyheder"],"channel":{"title":"P4","slug":"p4"},"imageAssets":[{"id":"urn:dr:radio:image:67e3d02da937a46b974f8ee0","target":"Default","ratio":"16:9","format":"image/jpeg"},{"id":"urn:dr:radio:image:67e3d02da937a46b974f8ee1","target":"SquareImage","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:67e3d02da937a46b974f8ee2","target":"Podcast","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:67e3d02da937a46b974f8ee1","target":"Default","ratio":"1:1","format":"image/jpeg"}]},{"type":"Series","id":"urn:dr:radio:series:6691159464091b8143b4efe4","title":"Barneliv gennem tiden","description":"Dengang mormor var barn, sneede det altid om vinteren, der var ingen smartphone at konkurrere med, og somrene varede evigt. Eller gjorde de? Var det bedre at være barn i 1950'erne? Eller 90'erne? I DR's radiomontager kan du møde nogle af de børn, vi har talt med, lige siden dengang vi hed Statsradiofonien, og høre, hvordan livet som barn har forandret sig gennem tiden.","numberOfEpisodes":10,"latestEpisodeStartTime":"1952-10-23T19:55:00+00:00","productionNumber":"5711523608000","presentationUrl":"https://www.dr.dk/lyd/p1/barneliv-gennem-tiden-5711523608000","isAvailableOnDemand":true,"explicitContent":false,"categories":["Kultur"],"channel":{"title":"P1","slug":"p1"},"imageAssets":[{"id":"urn:dr:radio:image:68b840807964fa5412a0ecf5","target":"Default","ratio":"16:9","format":"image/jpeg"},{"id":"urn:dr:radio:image:68b840807964fa5412a0ecf6","target":"SquareImage","ratio":"1:1","format":"image/jpeg"},{"id":"urn:dr:radio:image:68b840807964fa5412a0ecf6","target":"Default","ratio":"1:1","format":"image/jpeg"}]}]}
