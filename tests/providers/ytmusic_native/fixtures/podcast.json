           "title": {
            "runs": [
             {
              "text": "1976 - The Birth Year of Alt-Rock - Part 2",
              "navigationEndpoint": {
               "browseEndpoint": {
                "browseId": "MPEDlFUdx2p16Jg",
                "browseEndpointContextSupportedConfigs": {
                 "browseEndpointContextMusicConfig": {
                  "pageType": "MUSIC_PAGE_TYPE_NON_MUSIC_AUDIO_TRACK_PAGE"
                 }
                }
               }
              }
             }
            ]
           },
           "description": {
            "runs": [
             {
              "text": "If there was ever a Big Bang moment for alternative rock, 1976 might be it.\n\n\n\nIn Part 2 of our look at the birth of alternative rock, we follow punk's rise from New York to the UK, where bands like The Ramones, the Sex Pistols, The Clash, and The Damned helped kick off a musical revolution. What started as a small scene became the foundation for just about every form of alt-rock that came after. \n\n\n \n\n\nLearn more about your ad choices. Visit megaphone.fm/adchoices (https://megaphone.fm/adchoices)"
             }
            ]
           },
