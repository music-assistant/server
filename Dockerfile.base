# syntax=docker/dockerfile:1

# Python version is centralized in .python-version at repo root.
# Workflows read that file and pass it here via --build-arg PYTHON_VERSION=...
# The default below is a safety net for manual `docker build` without --build-arg.
ARG PYTHON_VERSION=3.14

# BASE docker image for music assistant container
# This image forms the base for the final image and is not meant to be used directly
# NOTE that the dev add-on is also based on this base image

FROM python:${PYTHON_VERSION}-slim-trixie AS ffmpeg-builder

# Enable non-free and contrib repositories for FDK-AAC and other codecs
# (trixie uses the deb822 sources format)
RUN sed -i 's/^Components: .*/Components: main contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources

# Install build dependencies for FFmpeg
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    yasm \
    nasm \
    git \
    ca-certificates \
    # Audio codec libraries
    libfdk-aac-dev \
    libmp3lame-dev \
    libopus-dev \
    libvorbis-dev \
    libsoxr-dev \
    libspeex-dev \
    libtwolame-dev \
    libvo-amrwbenc-dev \
    libopencore-amrnb-dev \
    libopencore-amrwb-dev \
    libshine-dev \
    # Audio processing and filters
    librubberband-dev \
    libbs2b-dev \
    libsamplerate0-dev \
    libmysofa-dev \
    libjack-jackd2-dev \
    libpulse-dev \
    # Additional libraries
    libbluray-dev \
    libxml2-dev \
    libssh-dev \
    liblzma-dev \
    # SSL/TLS support for HTTPS
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Build FFmpeg from source with comprehensive audio codec support
# Tags are mutable, so the fetched tag is verified against the pinned SHA. Renovate bumps
# both together.
# renovate: datasource=github-tags depName=FFmpeg/FFmpeg
ARG FFMPEG_VERSION=9.0.1
ARG FFMPEG_SHA=bf1b838f2ab88b4f8fd83443325c782ea0e0f7fa
RUN set -x \
    && git init /tmp/ffmpeg \
    && cd /tmp/ffmpeg \
    && git remote add origin https://github.com/FFmpeg/FFmpeg.git \
    && git fetch --depth 1 origin refs/tags/n${FFMPEG_VERSION} \
    && git checkout FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${FFMPEG_SHA}" \
    # without git metadata FFmpeg reports its release version (checked at startup)
    # instead of the commit hash, as the shallow fetch carries no tags
    && rm -rf .git \
    && ./configure \
        --prefix=/usr/local \
        --enable-gpl \
        --enable-nonfree \
        --enable-version3 \
        # Audio codecs (comprehensive support)
        --enable-libfdk-aac \
        --enable-libmp3lame \
        --enable-libopus \
        --enable-libvorbis \
        --enable-libspeex \
        --enable-libtwolame \
        --enable-libshine \
        --enable-libopencore-amrnb \
        --enable-libopencore-amrwb \
        --enable-libvo-amrwbenc \
        # Audio filters and resampling
        --enable-libsoxr \
        --enable-librubberband \
        --enable-libbs2b \
        --enable-libmysofa \
        --enable-libjack \
        --enable-libpulse \
        # SSL/TLS support for HTTPS
        --enable-openssl \
        # Additional libraries for playlist and network support
        --enable-libxml2 \
        --enable-libssh \
        --enable-lzma \
        # Optimizations
        --enable-runtime-cpudetect \
        # Disable unnecessary features for smaller build
        --disable-doc \
        --disable-htmlpages \
        --disable-manpages \
        --disable-podpages \
        --disable-txtpages \
        --disable-debug \
        --disable-static \
        --enable-shared \
    && make -j$(nproc) \
    && make install \
    && strip /usr/local/bin/ffmpeg /usr/local/bin/ffprobe \
    && rm -rf /tmp/ffmpeg

##################################################################################################

# PyAV wheel builder - builds PyAV against the custom FFmpeg
FROM python:${PYTHON_VERSION}-slim-trixie AS pyav-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ python3-dev pkg-config && rm -rf /var/lib/apt/lists/*

COPY --from=ffmpeg-builder /usr/local/lib/libav*.so* /usr/local/lib/
COPY --from=ffmpeg-builder /usr/local/lib/libsw*.so* /usr/local/lib/
COPY --from=ffmpeg-builder /usr/local/include/ /usr/local/include/
COPY --from=ffmpeg-builder /usr/local/lib/pkgconfig/ /usr/local/lib/pkgconfig/

RUN ldconfig
ENV PKG_CONFIG_PATH=/usr/local/lib/pkgconfig

# Build PyAV wheel against the custom FFmpeg with the in the Sendspin provider manifest pinned version
COPY music_assistant/providers/sendspin/manifest.json /tmp/sendspin_manifest.json
RUN PYAV_VERSION=$(python -c "import json; reqs=json.load(open('/tmp/sendspin_manifest.json'))['requirements']; print(next(r.split('==')[1] for r in reqs if r.startswith('av==')))") && \
    echo "Building PyAV version: ${PYAV_VERSION}" && \
    pip wheel --no-binary av av==${PYAV_VERSION} -w /wheels/

##################################################################################################

# Build shairport-sync (airplay receiver provider) from source on top of the FFmpeg build,
# so its ALAC decoder links against the FFmpeg libraries this image ships: classic AirPlay
# with stdout/pipe outputs and a metadata pipe. It needs no mDNS daemon: it hands its
# service to the provider over the metadata pipe, and the provider publishes it.
FROM ffmpeg-builder AS shairport-builder

# the FFmpeg build already provides the compiler, git, pkg-config and OpenSSL
RUN apt-get update && apt-get install -y --no-install-recommends \
    autoconf \
    automake \
    libtool \
    libconfig-dev \
    libpopt-dev \
    && rm -rf /var/lib/apt/lists/*

# Tags are mutable, so the fetched tag is verified against the pinned SHA. Renovate bumps
# both together.
# renovate: datasource=github-tags depName=mikebrady/shairport-sync
ARG SHAIRPORT_VERSION=5.6.3
ARG SHAIRPORT_SHA=7ce90d89529dd760488f20592a7cbff626672f6c
RUN set -x \
    && git init /tmp/shairport-sync \
    && cd /tmp/shairport-sync \
    && git remote add origin https://github.com/mikebrady/shairport-sync.git \
    && git fetch --depth 1 origin refs/tags/${SHAIRPORT_VERSION} \
    && git checkout FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${SHAIRPORT_SHA}" \
    # without git metadata the binary reports its release version (checked by the
    # provider) instead of the commit hash, as the shallow fetch carries no tags
    && rm -rf .git \
    && autoreconf -fi \
    && ./configure \
        --with-pipe \
        --with-metadata \
        --with-metadata-pipe \
        --with-ffmpeg \
        --without-avahi \
        --without-dns-sd \
        --with-ssl=openssl \
        --with-stdout \
        --sysconfdir=/etc \
    && make -j$(nproc) \
    && strip shairport-sync \
    && cp shairport-sync /usr/local/bin/shairport-sync \
    && rm -rf /tmp/shairport-sync

##################################################################################################

FROM python:${PYTHON_VERSION}-slim-trixie

# Ensure UTF-8 encoding across system
ENV LANG=C.UTF-8

# Enable non-free and contrib repositories for codec libraries
# (trixie uses the deb822 sources format)
RUN sed -i 's/^Components: .*/Components: main contrib non-free non-free-firmware/' /etc/apt/sources.list.d/debian.sources

# Install runtime dependencies
RUN set -x \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libjemalloc2 \
        tzdata \
        wget \
        # cifs-utils and nfs-common are needed to mount smb and nfs network shares
        cifs-utils \
        nfs-common \
        # airplay libraries
        openssl \
        libssl-dev \
        libuuid1 \
        libcurl4 \
        libsodium23 \
        libconfuse2 \
        libevent-dev \
        libjson-c5 \
        libgcrypt20 \
        # libsndfile needed for librosa audio file support (smartfades)
        libsndfile1 \
        # libchromaprint needed for AcoustID fingerprinting (acoustid_lookup)
        libchromaprint1 \
        # Audio codec runtime libraries (needed for FFmpeg)
        libfdk-aac2 \
        libmp3lame0 \
        libopus0 \
        libvorbis0a \
        libvorbisenc2 \
        libsoxr0 \
        libspeex1 \
        libtwolame0 \
        libshine3 \
        libopencore-amrnb0 \
        libopencore-amrwb0 \
        libvo-amrwbenc0 \
        # Audio processing libraries
        librubberband2 \
        libbs2b0 \
        libsamplerate0 \
        libmysofa1 \
        libjack-jackd2-0 \
        libpulse0 \
        # Additional libraries
        libbluray2 \
        libxml2 \
        libssh-4 \
        liblzma5 \
        # Snapcast dependencies
        libasound2 \
        # pactl, used by helpers/pulse_capture.py to suspend/resume sinks
        pulseaudio-utils \
        # PulseAudio daemon for MA's private audio-capture server (spotify connect soloist)
        pulseaudio \
        libvorbisidec1 \
        libflac14 \
        libavahi-client3 \
        libavahi-common3 \
        # AirPlay receiver dependencies (shairport-sync)
        libconfig11 \
        libpopt0 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f \
        /usr/bin/parecord \
        /usr/bin/paplay \
        /usr/bin/parec \
        /usr/bin/pamon \
        /usr/bin/pacat \
        /usr/bin/pasuspender \
        /usr/bin/pacmd

# Install Snapcast from GitHub releases (requires at least 0.27)
# The pinned SHA256s per arch are verified before install. Renovate bumps them together with
# the version.
# renovate: datasource=github-releases depName=snapcast/snapcast
ARG SNAPCAST_VERSION=0.35.0
ARG TARGETARCH
RUN set -x \
    && if [ "$TARGETARCH" = "arm64" ]; then \
        SNAPCAST_ARCH="arm64"; \
        # renovate: datasource=github-release-attachments depName=snapcast/snapcast digestVersion=v0.35.0
        SNAPSERVER_SHA256="be0c94ea3551c4ba4f4e5f810b18f6c85d9794ab32e4fc6c5e6886e096490914"; \
        # renovate: datasource=github-release-attachments depName=snapcast/snapcast digestVersion=v0.35.0
        SNAPCLIENT_SHA256="eced4134eeab132fc16af23ce19eb2f81abe23dd0f3c610150fb3bd1d344efae"; \
    else \
        SNAPCAST_ARCH="amd64"; \
        # renovate: datasource=github-release-attachments depName=snapcast/snapcast digestVersion=v0.35.0
        SNAPSERVER_SHA256="6a82325cf9eae68b75fb062491639cb31ec58288fe8930f53e86689e22a095da"; \
        # renovate: datasource=github-release-attachments depName=snapcast/snapcast digestVersion=v0.35.0
        SNAPCLIENT_SHA256="3c699b5800904534c10f4a68d0a8736035d8c4b8d8a93ab05a14d4dcae0f04a5"; \
    fi \
    && wget -q "https://github.com/snapcast/snapcast/releases/download/v${SNAPCAST_VERSION}/snapserver_${SNAPCAST_VERSION}-1_${SNAPCAST_ARCH}_trixie.deb" -O /tmp/snapserver.deb \
    && wget -q "https://github.com/snapcast/snapcast/releases/download/v${SNAPCAST_VERSION}/snapclient_${SNAPCAST_VERSION}-1_${SNAPCAST_ARCH}_trixie.deb" -O /tmp/snapclient.deb \
    && echo "${SNAPSERVER_SHA256}  /tmp/snapserver.deb" | sha256sum -c - \
    && echo "${SNAPCLIENT_SHA256}  /tmp/snapclient.deb" | sha256sum -c - \
    # install via apt so any missing dependencies of the debs are resolved as well
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/snapserver.deb /tmp/snapclient.deb \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && rm /tmp/snapserver.deb /tmp/snapclient.deb

# Install go-librespot (used by the Spotify Connect provider) from GitHub releases.
# The release binaries statically link libvorbis/libogg/libFLAC, so the only dynamic
# dependency is libasound2 (already installed above for Snapcast).
# The pinned SHA256 per arch is verified before extraction. Renovate bumps them together with
# the version.
# renovate: datasource=github-releases depName=devgianlu/go-librespot
ARG GO_LIBRESPOT_VERSION=0.10.7
RUN set -x \
    && if [ "$TARGETARCH" = "arm64" ]; then \
        GO_LIBRESPOT_ARCH="arm64"; \
        # renovate: datasource=github-release-attachments depName=devgianlu/go-librespot digestVersion=v0.10.7
        GO_LIBRESPOT_SHA256="1959a87033c5d8ff012e6f8acd1ca1994234104455d9796b688c8d2193e7f28b"; \
    else \
        GO_LIBRESPOT_ARCH="x86_64"; \
        # renovate: datasource=github-release-attachments depName=devgianlu/go-librespot digestVersion=v0.10.7
        GO_LIBRESPOT_SHA256="0712061edc269e935492c109c215c83d2998a240775789cb77d2a803f05fd816"; \
    fi \
    && wget -q "https://github.com/devgianlu/go-librespot/releases/download/v${GO_LIBRESPOT_VERSION}/go-librespot_linux_${GO_LIBRESPOT_ARCH}.tar.gz" -O /tmp/go-librespot.tar.gz \
    && echo "${GO_LIBRESPOT_SHA256}  /tmp/go-librespot.tar.gz" | sha256sum -c - \
    && tar -xzf /tmp/go-librespot.tar.gz -C /usr/local/bin go-librespot \
    && chmod +x /usr/local/bin/go-librespot \
    && rm /tmp/go-librespot.tar.gz

# Copy FFmpeg binaries and libraries from builder stage
COPY --from=ffmpeg-builder /usr/local/bin/ffmpeg /usr/local/bin/
COPY --from=ffmpeg-builder /usr/local/bin/ffprobe /usr/local/bin/
COPY --from=ffmpeg-builder /usr/local/lib/libav*.so* /usr/local/lib/
COPY --from=ffmpeg-builder /usr/local/lib/libsw*.so* /usr/local/lib/

# Copy shairport-sync binary from builder stage (found by the airplay receiver
# provider via its system PATH lookup)
COPY --from=shairport-builder /usr/local/bin/shairport-sync /usr/local/bin/

# Copy pre-built PyAV wheel for use by downstream images
COPY --from=pyav-builder /wheels/ /usr/local/share/pyav-wheels/

# Verify FFmpeg, shairport-sync and the custom PyAV wheel with all codec runtime libraries
# available.
RUN ldconfig && ffmpeg -version && ffprobe -version && shairport-sync --version \
    && python -m pip install --no-cache-dir --no-index --no-deps \
        --target /tmp/pyav-check /usr/local/share/pyav-wheels/av*.whl \
    && PYTHONPATH=/tmp/pyav-check python -c "import av; print(av.library_versions)" \
    && rm -rf /tmp/pyav-check

# Copy widevine client files to container
RUN mkdir -p /usr/local/bin/widevine_cdm
COPY widevine_cdm/* /usr/local/bin/widevine_cdm/

# we need to set (very permissive) permissions to the workdir
# and /tmp to allow running the container as non-root
RUN chmod -R 777 /tmp

LABEL \
    org.opencontainers.image.title="Music Assistant Base Image" \
    org.opencontainers.image.description="Base Image for Music Assistant server - not to be used directly" \
    org.opencontainers.image.source="https://github.com/music-assistant/server" \
    org.opencontainers.image.authors="The Music Assistant Team" \
    org.opencontainers.image.licenses="Apache License 2.0"
