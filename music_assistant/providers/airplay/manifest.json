  "domain": "airplay",
  "stage": "stable",
  "name": "AirPlay",
  "description": "Stream to AirPlay-enabled devices on your local network.",
  "codeowners": ["@music-assistant", "@bradkeifer"],
  "credits": ["[airplay-cli](https://github.com/music-assistant/airplay-cli)"],
  "requirements": ["srptools>=1.0.1"],
