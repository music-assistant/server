{
  "type": "player",
  "domain": "airplay",
  "stage": "stable",
  "name": "AirPlay",
  "description": "Stream to AirPlay-enabled devices on your local network.",
  "codeowners": ["@music-assistant", "@bradkeifer"],
  "credits": [
    "[airplay-cli](https://github.com/music-assistant/airplay-cli)",
    "[pyatv (Companion and MRP control)](https://github.com/postlund/pyatv)"
  ],
  "requirements": ["pyatv==0.18.0"],
  "documentation": "https://music-assistant.io/player-support/airplay/",
  "multi_instance": false,
  "builtin": false,
  "icon": "cast-variant",
  "mdns_discovery": [
    "_companion-link._tcp.local.",
    "_mediaremotetv._tcp.local.",
    "_airplay._tcp.local.",
    "_raop._tcp.local."
  ]
}
